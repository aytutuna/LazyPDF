<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyPDF.Core</RootNamespace>
    <Description>Platform-neutral core of Lazy PDF: the PDF file format, read, changed and written
again. Objects, filters, encryption, fonts, content streams, text, pages, annotations, forms,
signatures, redaction. No UI and no OS-specific APIs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LazyPDF.Core.Tests" />
    <InternalsVisibleTo Include="LazyPDF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
