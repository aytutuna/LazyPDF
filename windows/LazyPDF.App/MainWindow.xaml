<Window x:Class="LazyPDF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LazyPDF.App"
        xmlns:loc="clr-namespace:LazyPDF.App"
        Title="Lazy PDF"
        Width="1200" Height="800" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Static local:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated" Closing="Window_Closing">
    <Window.Resources>
        <!-- A document tab: the title, a dot while it has unsaved changes, and a close button. The selected tab has
             the accent pill under it, as the pivot tabs of the sisters do. -->
        <Style x:Key="DocumentTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,3,4,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="16" Height="3" CornerRadius="1.5" Margin="0,0,0,1"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DocumentTabTemplate">
            <DockPanel x:Name="Row" MinWidth="64" MaxWidth="220" Background="Transparent" ToolTip="{Binding Title}">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                        Width="28" Height="28" FontSize="10" Margin="6,0,0,0" IsTabStop="False"
                        ToolTip="{loc:T Close}" AutomationProperties.Name="{loc:T Close}" Click="CloseTab_Click" />
                <Ellipse x:Name="DirtyDot" DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                         ToolTip="{loc:T Unsaved changes}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource GlyphText}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanClose}" Value="False">
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Row" Property="Margin" Value="0,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="DirtyDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A button of the icon rail: only the glyph, an accent pill at the left edge while its panel is open. -->
        <Style x:Key="RailButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="-2,0,0,0" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrimStyle" TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The message bar: errors, and notices of what cannot be done or changed under the user's hands. -->
        <Border Grid.Row="0" x:Name="InfoBar" Style="{StaticResource InfoBarStyle}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="InfoBarGlyph" Style="{StaticResource GlyphText}" Text="&#xEB90;" Margin="0,0,12,0"
                           VerticalAlignment="Top" Padding="0,2,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;" KeyboardNavigation.TabIndex="1"
                        ToolTip="{loc:T Dismiss}" AutomationProperties.Name="{loc:T Dismiss}" VerticalAlignment="Top"
                        Click="InfoBarClose_Click" />
                <Button DockPanel.Dock="Right" x:Name="InfoBarAction" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Top"
                        Margin="8,0,4,0" Visibility="Collapsed" KeyboardNavigation.TabIndex="0" Click="InfoBarAction_Click" />
                <TextBlock x:Name="InfoBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"><Run x:Name="InfoBarTitle" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="InfoBarMessage" /></TextBlock>
            </DockPanel>
        </Border>

        <!-- The tab strip: Home, then the documents. The buttons for the file sit at the right. -->
        <DockPanel Grid.Row="1" x:Name="TabBar" Margin="8,4,8,2" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" KeyboardNavigation.TabIndex="2">
                <Button x:Name="OpenButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8E5;" ToolTip="{loc:T Open a file (Ctrl+O)}"
                        AutomationProperties.Name="{loc:T Open a file}" Click="Open_Click" />
                <Button x:Name="SaveButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" ToolTip="{loc:T Save (Ctrl+S)}"
                        AutomationProperties.Name="{loc:T Save}" Click="Save_Click" />
                <Button x:Name="SaveMenuButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;" ToolTip="{loc:T More ways to save}"
                        AutomationProperties.Name="{loc:T More ways to save}" Click="SaveMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SaveMenu">
                            <MenuItem x:Name="SaveAsItem" Header="{loc:T Save as…}" AutomationProperties.Name="{loc:T Save as}" Click="SaveAs_Click" />
                            <MenuItem x:Name="SaveCopyItem" Header="{loc:T Save a copy…}" AutomationProperties.Name="{loc:T Save a copy}"
                                      ToolTip="{loc:T Writes the file as it is now under another name and keeps this one as it is.}" Click="SaveCopy_Click" />
                            <MenuItem x:Name="SaveCompactItem" Header="{loc:T Save compact…}" AutomationProperties.Name="{loc:T Save compact}"
                                      ToolTip="{loc:T Writes the file again without its history of changes.}" Click="SaveCompact_Click" />
                            <Separator />
                            <MenuItem x:Name="SaveAllItem" Header="{loc:T Save all}" AutomationProperties.Name="{loc:T Save all}"
                                      ToolTip="{loc:T Saves every file that has changes.}" Click="SaveAll_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Rectangle Width="1" Margin="6,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" ToolTip="{loc:T Undo (Ctrl+Z)}"
                        AutomationProperties.Name="{loc:T Undo}" Click="Undo_Click" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}" Content="&#xE7A6;" ToolTip="{loc:T Redo (Ctrl+Y)}"
                        AutomationProperties.Name="{loc:T Redo}" Click="Redo_Click" />
                <Button x:Name="PrintButton" Style="{StaticResource IconButtonStyle}" Content="&#xE749;" ToolTip="{loc:T Print (Ctrl+P)}"
                        AutomationProperties.Name="{loc:T Print}" Click="Print_Click" />
                <Rectangle Width="1" Margin="6,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" ToolTip="{loc:T Settings}"
                        AutomationProperties.Name="{loc:T Settings}" Click="Settings_Click" />
            </StackPanel>
            <Button x:Name="TabOverflow" DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70D;" Visibility="Collapsed"
                    VerticalAlignment="Center" KeyboardNavigation.TabIndex="1" ToolTip="{loc:T All open files}"
                    AutomationProperties.Name="{loc:T All open files}" Click="TabOverflow_Click" />
            <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" KeyboardNavigation.TabIndex="0"
                     ItemContainerStyle="{StaticResource DocumentTabItemStyle}" ItemTemplate="{StaticResource DocumentTabTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{loc:T Open files}" AllowDrop="True"
                     SelectionChanged="TabList_SelectionChanged" PreviewMouseDown="TabList_PreviewMouseDown" PreviewKeyDown="TabList_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown" PreviewMouseMove="TabList_PreviewMouseMove"
                     Drop="TabList_Drop" DragOver="TabList_DragOver" ContextMenuOpening="TabList_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:TabStripPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <!-- The tool strip: a button for each group of tools; it opens the group's tools in a menu. Only the glyphs
             show while the window is narrow. -->
        <Border Grid.Row="2" x:Name="ToolStrip" BorderThickness="0,1,0,0" Padding="8,2,8,2" SizeChanged="ToolStrip_SizeChanged"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE946;" Click="FileInfo_Click"
                        ToolTip="{loc:T File information}" AutomationProperties.Name="{loc:T File information}" />
                <StackPanel x:Name="GroupPanel" Orientation="Horizontal" AutomationProperties.Name="{loc:T Tools}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" x:Name="ContentArea" SizeChanged="ContentArea_SizeChanged">
            <local:HomeView x:Name="Home" Visibility="Collapsed" />

            <Grid x:Name="Workspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SideColumn" Width="260" MinWidth="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="280" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- The icon rail; each button opens a side panel, and the one that is open closes it again. -->
                <StackPanel Grid.Column="0" x:Name="Rail" Width="48" AutomationProperties.Name="{loc:T Side panels}">
                    <Button x:Name="RailToggle" Style="{StaticResource IconButtonStyle}" Content="&#xE700;" Width="40" Margin="4,4,4,8"
                            ToolTip="{loc:T Show or hide the side panel}" AutomationProperties.Name="{loc:T Show or hide the side panel}"
                            Click="RailToggle_Click" />
                </StackPanel>

                <Border Grid.Column="1" x:Name="SidePane" Visibility="Collapsed" BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,8,4,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                                    ToolTip="{loc:T Close the side panel}" AutomationProperties.Name="{loc:T Close the side panel}" Click="SidePaneClose_Click" />
                            <TextBlock x:Name="SideTitle" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <!-- The side panels scroll themselves: the list in a panel has to know how tall it is to show only what is in view. -->
                        <ContentControl x:Name="SideHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </DockPanel>
                </Border>

                <!-- The stage: the viewer goes into ViewerHost. -->
                <Border Grid.Column="2" Style="{StaticResource StageStyle}" Margin="8,4,8,8">
                    <ContentControl x:Name="ViewerHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>

                <GridSplitter Grid.Column="2" x:Name="SideSplitter" Width="6" HorizontalAlignment="Left" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndCurrent" Background="Transparent" ShowsPreview="False" Cursor="SizeWE"
                              KeyboardIncrement="12" Visibility="Collapsed" AutomationProperties.Name="{loc:T Resize the side panel}"
                              DragCompleted="SideSplitter_Changed" KeyUp="SideSplitter_Changed" MouseDoubleClick="SideSplitter_Reset" />
                <GridSplitter Grid.Column="2" x:Name="InspectorSplitter" Width="6" HorizontalAlignment="Right" ResizeDirection="Columns"
                              ResizeBehavior="CurrentAndNext" Background="Transparent" ShowsPreview="False" Cursor="SizeWE"
                              KeyboardIncrement="12" Visibility="Collapsed" AutomationProperties.Name="{loc:T Resize the inspector}"
                              DragCompleted="InspectorSplitter_Changed" KeyUp="InspectorSplitter_Changed" MouseDoubleClick="InspectorSplitter_Reset" />

                <!-- The inspector: the panel of the active tool, with its action pinned below. -->
                <Border Grid.Column="3" x:Name="Inspector" BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="12,8,4,4">
                            <Button x:Name="InspectorClose" DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                                    ToolTip="{loc:T Close the tool}" AutomationProperties.Name="{loc:T Close the tool}" Click="InspectorClose_Click" />
                            <TextBlock x:Name="InspectorGlyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="InspectorTitle" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <ScrollViewer AutomationProperties.Name="{loc:T Tools}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="InspectorHost" IsTabStop="False" />
                        </ScrollViewer>
                        <Border Grid.Row="2" x:Name="InspectorFooter" Style="{StaticResource DialogFooterStyle}" Padding="12,10" Visibility="Collapsed">
                            <Button x:Name="InspectorAction" Style="{StaticResource AccentIconTextButtonStyle}" MinHeight="36"
                                    Click="InspectorAction_Click" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Password or certificate for a file that is locked. -->
            <Grid x:Name="PasswordOverlay" Style="{StaticResource OverlayScrimStyle}" PreviewKeyDown="PasswordOverlay_PreviewKeyDown">
                <Border Style="{StaticResource DialogCardStyle}" MaxWidth="440" MinWidth="340" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PasswordOpen" Style="{StaticResource AccentButtonStyle}" Content="{loc:T _Open}" AutomationProperties.Name="{loc:T Open}" MinWidth="88"
                                        Margin="0,0,8,0" IsDefault="True" Click="PasswordOpen_Click" />
                                <Button Content="{loc:T _Cancel}" AutomationProperties.Name="{loc:T Cancel}" MinWidth="88" IsCancel="True" Click="PasswordCancel_Click" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="24,20,24,20">
                            <TextBlock x:Name="PasswordTitle" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="PasswordText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="{loc:T Password}" />
                            <ListBox x:Name="CertificateList" MaxHeight="180" Visibility="Collapsed" AutomationProperties.Name="{loc:T Certificates}"
                                     SelectionChanged="CertificateList_SelectionChanged" />
                            <TextBlock x:Name="PasswordProblem" Style="{StaticResource ReasonText}" Margin="0,8,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- What to do with the changes of a document that is closing. -->
            <Grid x:Name="CloseOverlay" Style="{StaticResource OverlayScrimStyle}" PreviewKeyDown="CloseOverlay_PreviewKeyDown">
                <Border Style="{StaticResource DialogCardStyle}" MaxWidth="560" MinWidth="340" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
                          <DockPanel>
                            <StackPanel x:Name="CloseAllGroup" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Style="{StaticResource SubtleButtonStyle}" Content="{loc:T Save all}" AutomationProperties.Name="{loc:T Save all}" Margin="0,0,8,0"
                                        Click="CloseSaveAll_Click" />
                                <Button x:Name="CloseDiscardAllButton" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0"
                                        Click="CloseDiscardAll_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CloseSaveButton" Style="{StaticResource AccentButtonStyle}" Content="{loc:T _Save}" AutomationProperties.Name="{loc:T Save}" MinWidth="88" Margin="0,0,8,0"
                                        IsDefault="True" Click="CloseSave_Click" />
                                <Button x:Name="CloseDiscardButton" MinWidth="88" Margin="0,0,8,0" Click="CloseDiscard_Click" />
                                <Button x:Name="CloseCancelButton" Content="{loc:T _Cancel}" AutomationProperties.Name="{loc:T Cancel}" MinWidth="88" IsCancel="True" Click="CloseCancel_Click" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <StackPanel Margin="24,20,24,20">
                            <TextBlock x:Name="CloseTitle" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="CloseBody" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- After a crash: the documents that were open with changes. -->
            <Grid x:Name="RecoveryOverlay" Style="{StaticResource OverlayScrimStyle}">
                <Border Style="{StaticResource DialogCardStyle}" MaxWidth="480" MinWidth="340" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RestoreButton" Style="{StaticResource AccentButtonStyle}" Content="{loc:T _Restore}" AutomationProperties.Name="{loc:T Restore}" MinWidth="88" Margin="0,0,8,0"
                                        IsDefault="True" Click="Restore_Click" />
                                <Button Content="{loc:T _Discard}" AutomationProperties.Name="{loc:T Discard}" MinWidth="88" Click="DiscardRecovery_Click" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="24,20,24,20">
                            <TextBlock x:Name="RecoveryTitle" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="{loc:T Lazy PDF closed before these were saved. Restore them to carry on where you were.}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="RecoveryList" />
                            </ScrollViewer>
                            <TextBlock x:Name="RecoveryUntickedNote" Text="{loc:T Files you untick are removed.}" Style="{StaticResource ReasonText}" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Appearance and the Windows integration. -->
            <Grid x:Name="SettingsOverlay" Style="{StaticResource OverlayScrimStyle}" PreviewKeyDown="SettingsOverlay_PreviewKeyDown">
                <Border Style="{StaticResource DialogCardStyle}" MaxWidth="480" MinWidth="340" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
                            <Button x:Name="SettingsDoneButton" Content="{loc:T Done}" AutomationProperties.Name="{loc:T Done}" MinWidth="88" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                                    Click="SettingsDone_Click" />
                        </Border>
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,20">
                                <TextBlock Text="{loc:T Settings}" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"
                                           AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock Text="{loc:T Appearance}" Style="{StaticResource FieldLabelText}" />
                                <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,4,0,16" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AppearanceSystem" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Windows}"
                                                     GroupName="Appearance" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Follow Windows}"
                                                     Checked="Appearance_Checked" />
                                        <RadioButton x:Name="AppearanceLight" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Light}"
                                                     GroupName="Appearance" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Light}"
                                                     Checked="Appearance_Checked" />
                                        <RadioButton x:Name="AppearanceDark" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Dark}"
                                                     GroupName="Appearance" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Dark}"
                                                     Checked="Appearance_Checked" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Language}" Style="{StaticResource FieldLabelText}" />
                                <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LanguageSystem" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Windows}"
                                                     GroupName="Language" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Follow Windows}"
                                                     Checked="Language_Checked" />
                                        <RadioButton x:Name="LanguageEnglish" Style="{StaticResource SegmentedTextItemStyle}" Content="English"
                                                     GroupName="Language" Padding="14,5,14,6" Checked="Language_Checked" />
                                        <RadioButton x:Name="LanguageTurkish" Style="{StaticResource SegmentedTextItemStyle}" Content="Türkçe"
                                                     GroupName="Language" Padding="14,5,14,6" Checked="Language_Checked" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Takes effect the next time Lazy PDF starts.}" Style="{StaticResource ReasonText}" Margin="0,6,0,16" />
                                <StackPanel x:Name="OpenWithSection">
                                    <CheckBox x:Name="OpenWithToggle" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Show Lazy PDF in Open with}"
                                              AutomationProperties.Name="{loc:T Show Lazy PDF in Open with}" Click="OpenWith_Click" />
                                    <TextBlock Text="{loc:T 'Adds Lazy PDF to the Open with list of PDF files and registers lazypdf: addresses, for your account only. It never becomes the default program.'}"
                                               Style="{StaticResource ReasonText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ReopenLastToggle" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Reopen the files from last time}"
                                          AutomationProperties.Name="{loc:T Reopen the files from last time}" Margin="0,12,0,0" Click="ReopenLast_Click" />
                                <TextBlock Text="{loc:T 'When Lazy PDF starts without a file, it opens the files that were open when you closed it.'}"
                                           Style="{StaticResource ReasonText}" Margin="0,6,0,0" />
                                <Button Style="{StaticResource SubtleButtonStyle}" Content="{loc:T Choose default apps}"
                                        AutomationProperties.Name="{loc:T Choose default apps}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="DefaultApps_Click" />
                                <TextBlock Text="{loc:T 'Opens Windows settings, where you can pick the program that opens PDF files.'}"
                                           Style="{StaticResource ReasonText}" Margin="0,6,0,0" />
                                <Button x:Name="AboutButton" Style="{StaticResource SubtleButtonStyle}" Content="{loc:T About Lazy PDF}"
                                        AutomationProperties.Name="{loc:T About Lazy PDF}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="About_Click" />

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Name, version, links and the notices for the code and data that ship with the app. -->
            <Grid x:Name="AboutOverlay" Style="{StaticResource OverlayScrimStyle}" PreviewKeyDown="AboutOverlay_PreviewKeyDown">
                <Border Style="{StaticResource DialogCardStyle}" MaxWidth="560" MinWidth="340" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
                            <Button x:Name="AboutDoneButton" Content="{loc:T Done}" AutomationProperties.Name="{loc:T Done}" MinWidth="88" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                                    Click="AboutDone_Click" />
                        </Border>
                        <StackPanel Margin="24,20,24,20">
                            <TextBlock Text="Lazy PDF" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                            <TextBlock x:Name="AboutCopyright" Style="{StaticResource SecondaryBodyText}" Margin="0,2,0,0" />
                            <TextBlock Text="{loc:T Free. Source available under PolyForm Noncommercial 1.0.0.}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="-11,8,0,12">
                                <Button x:Name="SiteLink" Style="{StaticResource SubtleButtonStyle}" Click="SiteLink_Click" />
                                <Button x:Name="PrivacyLink" Style="{StaticResource SubtleButtonStyle}" Content="{loc:T Privacy}"
                                        AutomationProperties.Name="{loc:T Privacy}" Click="PrivacyLink_Click" />
                                <Button x:Name="SupportLink" Style="{StaticResource SubtleButtonStyle}" Click="SupportLink_Click" />
                            </StackPanel>
                            <TextBlock Text="{loc:T Third-party notices}" Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="AboutNotices" IsReadOnly="True" TextWrapping="NoWrap" Height="200" Margin="0,4,0,0" Padding="8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     AutomationProperties.Name="{loc:T Third-party notices}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- While files are dragged over the window: where they go. -->
        <Border Grid.Row="3" x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="8"
                CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Style="{StaticResource DialogCardStyle}" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphText}" FontSize="24" Text="&#xE8E5;" Margin="0,0,12,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{loc:T Drop files to open them}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- The status bar: the short status line, where the viewer is, and the busy bar with its Cancel. -->
        <StatusBar Grid.Row="4" Background="Transparent" BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" MinHeight="36" Height="36" Padding="8,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="BusyBar" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                                 IsIndeterminate="True" AutomationProperties.Name="{loc:T Progress}" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Style="{StaticResource IconTextButtonStyle}" local:Icon.Glyph="&#xE711;"
                            Content="{loc:T Cancel}" AutomationProperties.Name="{loc:T Cancel}" Padding="10,3,10,4" Visibility="Collapsed" Click="Cancel_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="ZoomText" Style="{StaticResource CaptionText}" FontSize="13" Margin="12,0,0,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="PageBoxText" Style="{StaticResource CaptionText}" FontSize="13" Margin="12,0,0,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="PageText" Style="{StaticResource CaptionText}" FontSize="13" Margin="12,0,0,0" />
            </StatusBarItem>
            <StatusBarItem>
                <!-- A short line on screen; its name is the whole sentence, read out as it changes. -->
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
