<tools:ToolPanel x:Class="LazyPDF.App.Panels.Layers.LayersSidePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:panel="clr-namespace:LazyPDF.App.Panels.Layers">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ReasonText}" Margin="12,8,12,12" Text="{loc:T Showing or hiding a layer changes the view only. The file stays as it is.}" />
        <Grid>
            <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="4,4,4,8" AutomationProperties.Name="{loc:T Layers}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type panel:LayerRow}" ItemsSource="{Binding Children}">
                        <Grid>
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}" Content="{Binding Name}" Margin="0,3"
                                      Visibility="{Binding CheckVisibility}" AutomationProperties.Name="{Binding Name}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" Margin="0,3" Visibility="{Binding LabelVisibility}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock x:Name="Empty" Style="{StaticResource ReasonText}" Margin="12,8" Visibility="Collapsed" Text="{loc:T This file has no layers.}" />
        </Grid>
    </DockPanel>
</tools:ToolPanel>
