<tools:ToolPanel x:Class="LazyPDF.App.Panels.Pages.PagesSidePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:panel="clr-namespace:LazyPDF.App.Panels.Pages">
    <ListBox x:Name="Thumbs" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{loc:T Page thumbnails}"
             AllowDrop="True" SelectionMode="Extended" SelectionChanged="Thumbs_SelectionChanged" PreviewKeyDown="Thumbs_PreviewKeyDown"
             PreviewMouseRightButtonDown="Thumbs_PreviewMouseRightButtonDown"
             PreviewMouseLeftButtonDown="Thumbs_PreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="Thumbs_PreviewMouseLeftButtonUp"
             PreviewMouseMove="Thumbs_PreviewMouseMove" DragOver="Thumbs_DragOver" DragLeave="Thumbs_DragLeave" Drop="Thumbs_Drop">
        <ListBox.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{loc:T Rotate left}" Click="TurnLeft_Click" />
                <MenuItem Header="{loc:T Rotate right}" Click="TurnRight_Click" />
                <MenuItem Header="{loc:T Delete}" InputGestureText="Del" Click="Delete_Click" />
                <MenuItem Header="{loc:T Extract to a new file}" Click="Extract_Click" />
            </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThumbnailListItemStyle}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type panel:PageThumb}">
                <Grid>
                    <StackPanel Margin="8,8,8,4" HorizontalAlignment="Center">
                        <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="{StaticResource ThumbnailCornerRadius}" Background="White"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" SnapsToDevicePixels="True">
                            <Image Source="{Binding Image}" Stretch="Uniform" Unloaded="Thumb_Unloaded" AutomationProperties.Name="{Binding Name}" />
                        </Border>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border x:Name="Before" Height="2" VerticalAlignment="Top" Margin="4,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                    <Border x:Name="After" Height="2" VerticalAlignment="Bottom" Margin="4,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DropBefore}" Value="True">
                        <Setter TargetName="Before" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropAfter}" Value="True">
                        <Setter TargetName="After" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</tools:ToolPanel>
