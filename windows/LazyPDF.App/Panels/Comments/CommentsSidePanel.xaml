<tools:ToolPanel x:Class="LazyPDF.App.Panels.Comments.CommentsSidePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:panel="clr-namespace:LazyPDF.App.Panels.Comments">
    <Grid>
        <ListBox x:Name="Comments" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{loc:T Comments}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonUp="Comments_PreviewMouseLeftButtonUp"
                 PreviewKeyDown="Comments_PreviewKeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type panel:CommentRow}">
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TextVisibility}" />
                        <TextBlock Text="{Binding Where}" Style="{StaticResource SecondaryBodyText}" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Style="{StaticResource ReasonText}" Margin="12,8" Visibility="Collapsed" Text="{loc:T This file has no comments.}" />
    </Grid>
</tools:ToolPanel>
