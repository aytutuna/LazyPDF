<tools:ToolPanel x:Class="LazyPDF.App.Panels.Bookmarks.BookmarksSidePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:panel="clr-namespace:LazyPDF.App.Panels.Bookmarks">
    <DockPanel>
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="8,0,8,4">
            <Button x:Name="AddButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;" Click="Add_Click"
                    ToolTip="{loc:T Add a bookmark for this page}" AutomationProperties.Name="{loc:T Add bookmark}" />
            <Button x:Name="RenameButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70F;" Click="Rename_Click" IsEnabled="False"
                    ToolTip="{loc:T Rename}" AutomationProperties.Name="{loc:T Rename}" />
            <Button x:Name="DeleteButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74D;" Click="Delete_Click" IsEnabled="False"
                    ToolTip="{loc:T Delete (Del)}" AutomationProperties.Name="{loc:T Delete}" />
            <Button x:Name="MoveUpButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74A;" Click="MoveUp_Click" IsEnabled="False"
                    ToolTip="{loc:T Move up}" AutomationProperties.Name="{loc:T Move up}" />
            <Button x:Name="MoveDownButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74B;" Click="MoveDown_Click" IsEnabled="False"
                    ToolTip="{loc:T Move down}" AutomationProperties.Name="{loc:T Move down}" />
            <Button x:Name="OutdentButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE290;" Click="Outdent_Click" IsEnabled="False"
                    ToolTip="{loc:T Move out}" AutomationProperties.Name="{loc:T Move out}" />
            <Button x:Name="IndentButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE291;" Click="Indent_Click" IsEnabled="False"
                    ToolTip="{loc:T Move in}" AutomationProperties.Name="{loc:T Move in}" />
            <Button x:Name="ExpandAllButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70D;" Click="ExpandAll_Click"
                    ToolTip="{loc:T Expand all}" AutomationProperties.Name="{loc:T Expand all}" />
            <Button x:Name="CollapseAllButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70E;" Click="CollapseAll_Click"
                    ToolTip="{loc:T Collapse all}" AutomationProperties.Name="{loc:T Collapse all}" />
        </WrapPanel>
        <Grid>
        <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="4,4,4,8" AutomationProperties.Name="{loc:T Bookmarks}"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown" PreviewKeyDown="Tree_PreviewKeyDown"
                  SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="AddItem" Header="{loc:T Add bookmark}" Click="Add_Click" />
                    <MenuItem x:Name="RenameItem" Header="{loc:T Rename}" InputGestureText="F2" Click="Rename_Click" />
                    <MenuItem x:Name="DeleteItem" Header="{loc:T Delete}" InputGestureText="Del" Click="Delete_Click" />
                    <MenuItem x:Name="MoveUpItem" Header="{loc:T Move up}" InputGestureText="Alt+Up" Click="MoveUp_Click" />
                    <MenuItem x:Name="MoveDownItem" Header="{loc:T Move down}" InputGestureText="Alt+Down" Click="MoveDown_Click" />
                    <MenuItem x:Name="OutdentItem" Header="{loc:T Move out}" InputGestureText="Alt+Left" Click="Outdent_Click" />
                    <MenuItem x:Name="IndentItem" Header="{loc:T Move in}" InputGestureText="Alt+Right" Click="Indent_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type panel:BookmarkNode}" ItemsSource="{Binding Children}">
                    <Grid>
                        <TextBlock Text="{Binding Title}" FontWeight="{Binding Weight}" FontStyle="{Binding Style}" TextWrapping="Wrap" Margin="0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="0,1" AutomationProperties.Name="{loc:T Rename}"
                                 PreviewKeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus" IsVisibleChanged="EditBox_IsVisibleChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock x:Name="Empty" Style="{StaticResource ReasonText}" Margin="12,8" Visibility="Collapsed" Text="{loc:T This file has no bookmarks.}" />
        </Grid>
    </DockPanel>
</tools:ToolPanel>
