<UserControl x:Class="LazyPDF.App.Viewer.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LazyPDF.App"
             AutomationProperties.Name="{loc:T Find in the document}">
    <Border Style="{StaticResource CardStyle}" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" Padding="8" MinWidth="260" MaxWidth="420" Effect="{DynamicResource CardHoverShadow}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="3" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;" Margin="2,0,0,0"
                        ToolTip="{loc:T Close the find bar}" AutomationProperties.Name="{loc:T Close the find bar}" Click="Close_Click" />
                <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="2" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70D;"
                        ToolTip="{loc:T Next match (F3)}" AutomationProperties.Name="{loc:T Next match}" Click="Next_Click" />
                <Button DockPanel.Dock="Right" KeyboardNavigation.TabIndex="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70E;" Margin="4,0,0,0"
                        ToolTip="{loc:T Previous match (Shift+F3)}" AutomationProperties.Name="{loc:T Previous match}" Click="Previous_Click" />
                <TextBox x:Name="Query" KeyboardNavigation.TabIndex="0" MinHeight="30" VerticalContentAlignment="Center" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"
                         AutomationProperties.Name="{loc:T Find text}" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="CaseToggle" Content="Aa" MinWidth="34" Height="28" Padding="6,0" Click="Option_Click"
                                  ToolTip="{loc:T Match case}" AutomationProperties.Name="{loc:T Match case}" />
                    <ToggleButton x:Name="WordToggle" Content="ab" MinWidth="34" Height="28" Padding="6,0" Margin="4,0,0,0" Click="Option_Click"
                                  ToolTip="{loc:T Whole words}" AutomationProperties.Name="{loc:T Whole words}" />
                    <ToggleButton x:Name="RegexToggle" Content=".*" MinWidth="34" Height="28" Padding="6,0" Margin="4,0,0,0" Click="Option_Click"
                                  ToolTip="{loc:T Regular expression}" AutomationProperties.Name="{loc:T Regular expression}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
