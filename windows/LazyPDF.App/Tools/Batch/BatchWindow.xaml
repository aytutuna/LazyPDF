<Window x:Class="LazyPDF.App.Tools.Batch.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LazyPDF.App"
        xmlns:batch="clr-namespace:LazyPDF.App.Tools.Batch"
        Title="{loc:T Batch}" Width="440" Height="640" MinWidth="320" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource TextFontFamily}" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer AutomationProperties.Name="{loc:T Batch}" VerticalScrollBarVisibility="Auto">
            <batch:BatchPanel x:Name="Panel" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="12,8,12,0">
            <TextBlock x:Name="MessageTitle" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                         AutomationProperties.Name="{loc:T Running the steps}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" MinWidth="88" Margin="0,0,8,0" Click="RunButton_Click" />
            <Button x:Name="CancelButton" Content="{loc:T _Cancel}" MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed"
                    AutomationProperties.Name="{loc:T Cancel}" Click="CancelButton_Click" />
            <Button Content="{loc:T C_lose}" MinWidth="88" IsCancel="True" AutomationProperties.Name="{loc:T Close}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
