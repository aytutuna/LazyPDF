<tools:ToolPanel x:Class="LazyPDF.App.Tools.EditContent.EditContentPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools">
    <tools:ToolPanel.Resources>
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </tools:ToolPanel.Resources>
    <StackPanel Margin="12,4,12,16">
        <Border Style="{StaticResource SegmentedTrackStyle}">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ModeSelect" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Select}" GroupName="EditMode" IsChecked="True"
                             AutomationProperties.Name="{loc:T Select objects}" Checked="Mode_Checked" Click="Mode_Click" />
                <RadioButton x:Name="ModeText" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Text box}" GroupName="EditMode"
                             AutomationProperties.Name="{loc:T Add a text box}" Checked="Mode_Checked" Click="Mode_Click" />
                <RadioButton x:Name="ModeLink" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Link}" GroupName="EditMode"
                             AutomationProperties.Name="{loc:T Add or change a link}" Checked="Mode_Checked" Click="Mode_Click" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="Hint" Style="{StaticResource ReasonText}" Margin="2,8,2,0" />

        <DockPanel x:Name="MessageRow" Margin="2,10,2,0" Visibility="Collapsed">
            <TextBlock x:Name="MessageGlyph" DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" />
            <TextBlock x:Name="MessageText" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <Button x:Name="AddPicture" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xEB9F;" Content="{loc:T Add a picture}" Margin="0,12,0,0"
                HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Add a picture}" Click="AddPicture_Click" />

        <StackPanel x:Name="TextSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Text}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{loc:T Font}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <ComboBox x:Name="FontBox" IsEditable="True" AutomationProperties.Name="{loc:T Font}" DropDownClosed="FontBox_DropDownClosed"
                      PreviewKeyDown="FontBox_PreviewKeyDown" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:T Size}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SizeBox" Width="64" AutomationProperties.Name="{loc:T Size in points}" PreviewKeyDown="Value_PreviewKeyDown"
                                 LostKeyboardFocus="SizeBox_LostKeyboardFocus" />
                        <TextBlock Text="{loc:T pt}" Style="{StaticResource SecondaryBodyText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="36" Margin="0,0,4,0" AutomationProperties.Name="{loc:T Bold}"
                                  Click="Bold_Click" />
                    <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" FontFamily="Times New Roman" Width="36" AutomationProperties.Name="{loc:T Italic}"
                                  Click="Italic_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{loc:T Colour}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <WrapPanel x:Name="TextColors" />
            <TextBlock Text="{loc:T Alignment}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <Border Style="{StaticResource SegmentedTrackStyle}">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="AlignLeft" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Left}" GroupName="Align"
                                 AutomationProperties.Name="{loc:T Align left}" Click="Align_Click" />
                    <RadioButton x:Name="AlignCenter" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Centre}" GroupName="Align"
                                 AutomationProperties.Name="{loc:T Align centre}" Click="Align_Click" />
                    <RadioButton x:Name="AlignRight" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Right}" GroupName="Align"
                                 AutomationProperties.Name="{loc:T Align right}" Click="Align_Click" />
                    <RadioButton x:Name="AlignJustify" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Justify}" GroupName="Align"
                                 AutomationProperties.Name="{loc:T Justify}" Click="Align_Click" />
                </UniformGrid>
            </Border>
            <StackPanel x:Name="SpacingRow" Margin="0,8,0,0">
                <TextBlock Text="{loc:T Line spacing}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SpacingBox" Width="64" AutomationProperties.Name="{loc:T Line spacing in points}" PreviewKeyDown="Value_PreviewKeyDown"
                             LostKeyboardFocus="SpacingBox_LostKeyboardFocus" />
                    <TextBlock Text="{loc:T pt}" Style="{StaticResource SecondaryBodyText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="ParagraphButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE70F;" Content="{loc:T Reflow the paragraph}" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Reflow the paragraph}" Click="Paragraph_Click" />
            <TextBlock x:Name="ParagraphReason" Style="{StaticResource ReasonText}" Margin="2,6,2,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="ImageSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Picture}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button x:Name="ReplaceImage" Content="{loc:T Replace}" Margin="0,0,4,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Replace the picture}"
                        Click="ReplaceImage_Click" />
                <Button x:Name="ExtractImage" Content="{loc:T Save as file}" Margin="4,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Save the picture as a file}"
                        Click="ExtractImage_Click" />
                <Button x:Name="CropImage" Content="{loc:T Crop}" Margin="0,0,4,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Crop the picture}"
                        Click="CropImage_Click" />
            </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="ShapeSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Shape}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{loc:T Fill}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <WrapPanel x:Name="FillColors" />
            <TextBlock Text="{loc:T Line}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <WrapPanel x:Name="LineColors" />
            <TextBlock Text="{loc:T Line width}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="WidthBox" Width="64" AutomationProperties.Name="{loc:T Line width in points}" PreviewKeyDown="Value_PreviewKeyDown"
                         LostKeyboardFocus="WidthBox_LostKeyboardFocus" />
                <TextBlock Text="{loc:T pt}" Style="{StaticResource SecondaryBodyText}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="OpacitySection" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock x:Name="OpacityReadout" DockPanel.Dock="Right" Style="{StaticResource ReadoutText}" Width="44" />
                <TextBlock Text="{loc:T Opacity}" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
            </DockPanel>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="10" AutomationProperties.Name="{loc:T Opacity}"
                    ValueChanged="Opacity_ValueChanged" />
        </StackPanel>

        <StackPanel x:Name="ArrangeSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Arrange}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <UniformGrid x:Name="OrderGrid" Columns="2" Margin="0,8,0,0">
                <Button x:Name="ToFront" Content="{loc:T To front}" Margin="0,0,4,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Bring to front}" Click="Order_Click" />
                <Button x:Name="Forward" Content="{loc:T Forward}" Margin="4,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Bring forward}" Click="Order_Click" />
                <Button x:Name="Backward" Content="{loc:T Backward}" Margin="0,0,4,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Send backward}" Click="Order_Click" />
                <Button x:Name="ToBack" Content="{loc:T To back}" Margin="4,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Send to back}" Click="Order_Click" />
            </UniformGrid>
            <UniformGrid Columns="2">
                <Button x:Name="RotateLeft" Content="{loc:T Turn left}" Margin="0,0,4,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Turn left 90 degrees}" Click="Rotate_Click" />
                <Button x:Name="RotateRight" Content="{loc:T Turn right}" Margin="4,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Turn right 90 degrees}" Click="Rotate_Click" />
                <Button x:Name="FlipAcross" Content="{loc:T Flip across}" Margin="0,0,4,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Flip left to right}" Click="Flip_Click" />
                <Button x:Name="FlipDown" Content="{loc:T Flip down}" Margin="4,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Flip top to bottom}" Click="Flip_Click" />
            </UniformGrid>
            <Button x:Name="DeleteButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE74D;" Content="{loc:T Delete}" Margin="0,4,0,0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Delete the selection}" Click="Delete_Click" />
        </StackPanel>

        <StackPanel x:Name="LinkSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Link}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,8,0,0">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="ToWeb" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Web address}" GroupName="LinkKind" IsChecked="True"
                                 AutomationProperties.Name="{loc:T Link to a web address}" Checked="LinkKind_Checked" />
                    <RadioButton x:Name="ToPage" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Page}" GroupName="LinkKind"
                                 AutomationProperties.Name="{loc:T Link to a page}" Checked="LinkKind_Checked" />
                </UniformGrid>
            </Border>
            <TextBox x:Name="LinkBox" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Where the link goes}" TextChanged="LinkBox_TextChanged" PreviewKeyDown="LinkBox_PreviewKeyDown" />
            <Button x:Name="RemoveLink" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE74D;" Content="{loc:T Remove the link}" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Remove the link}" Click="RemoveLink_Click" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="{loc:T Replace in the whole file}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{loc:T Find}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <TextBox x:Name="FindBox" AutomationProperties.Name="{loc:T Text to find}" TextChanged="Find_TextChanged" PreviewKeyDown="Find_PreviewKeyDown" />
            <TextBlock Text="{loc:T Replace with}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
            <TextBox x:Name="ReplaceBox" AutomationProperties.Name="{loc:T Text to put in its place}" PreviewKeyDown="Find_PreviewKeyDown" />
            <CheckBox x:Name="MatchCase" Content="{loc:T Match case}" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Match case}" />
            <CheckBox x:Name="WholeWord" Content="{loc:T Whole words only}" AutomationProperties.Name="{loc:T Whole words only}" />
            <Button x:Name="ReplaceAllButton" Content="{loc:T Replace all}" Margin="0,8,0,0" HorizontalAlignment="Stretch" IsEnabled="False"
                    AutomationProperties.Name="{loc:T Replace all}" Click="ReplaceAll_Click" />
        </StackPanel>
    </StackPanel>
</tools:ToolPanel>
