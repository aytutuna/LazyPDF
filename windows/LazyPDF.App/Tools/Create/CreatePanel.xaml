<tools:ToolPanel x:Class="LazyPDF.App.Tools.Create.CreatePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 AllowDrop="True" PreviewDragOver="Panel_DragOver" PreviewDrop="Panel_Drop"
                 Loaded="CreatePanel_Loaded" Unloaded="CreatePanel_Unloaded">
    <StackPanel Margin="12,4,12,12">
        <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Make a PDF from}" />
        <ComboBox x:Name="SourceBox" SelectedIndex="0" AutomationProperties.Name="{loc:T Make a PDF from}" SelectionChanged="SourceBox_SelectionChanged">
            <ComboBoxItem Content="{loc:T Blank pages}" />
            <ComboBoxItem Content="{loc:T Pictures}" />
            <ComboBoxItem Content="{loc:T Text}" />
            <ComboBoxItem Content="{loc:T Web page file (.html or .htm)}" />
            <ComboBoxItem Content="{loc:T 'A Word, Excel or PowerPoint file'}" />
            <ComboBoxItem Content="{loc:T Clipboard}" />
        </ComboBox>

        <StackPanel x:Name="BlankOptions" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Number of pages}" />
            <TextBox x:Name="BlankPagesBox" Text="1" MaxLength="3" HorizontalAlignment="Left" Width="80" AutomationProperties.Name="{loc:T Number of pages}"
                     TextChanged="Input_Changed" />
        </StackPanel>

        <StackPanel x:Name="PictureOptions" Margin="0,16,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE710;" Content="{loc:T Add pictures}" Padding="10,3,10,4" HorizontalAlignment="Left"
                    AutomationProperties.Name="{loc:T Add pictures}" Click="AddPictures_Click" />
            <ListBox x:Name="PictureList" Margin="0,8,0,0" MinHeight="64" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{loc:T Pictures}" SelectionChanged="PictureList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="MoveUp" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70E;" ToolTip="{loc:T Move up}"
                        AutomationProperties.Name="{loc:T Move up}" Click="MoveUp_Click" />
                <Button x:Name="MoveDown" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE70D;" ToolTip="{loc:T Move down}" Margin="4,0,0,0"
                        AutomationProperties.Name="{loc:T Move down}" Click="MoveDown_Click" />
                <Button x:Name="RemovePicture" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74D;" ToolTip="{loc:T Remove}" Margin="4,0,0,0"
                        AutomationProperties.Name="{loc:T Remove}" Click="RemovePicture_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="TextOptions" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Text for the pages}" />
            <TextBox x:Name="TypedText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="200"
                     AutomationProperties.Name="{loc:T Text for the pages}" TextChanged="Input_Changed" />
            <StackPanel x:Name="LongTextRow" Visibility="Collapsed">
                <TextBlock x:Name="LongTextNote" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
                <Button Style="{StaticResource IconTextButtonStyle}" Content="{loc:T Use typed text instead}" Padding="10,3,10,4" HorizontalAlignment="Left"
                        Margin="0,8,0,0" AutomationProperties.Name="{loc:T Use typed text instead}" Click="UseTypedText_Click" />
            </StackPanel>
            <Button Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE8E5;" Content="{loc:T Open a text file}" Padding="10,3,10,4" HorizontalAlignment="Left"
                    Margin="0,8,0,0" AutomationProperties.Name="{loc:T Open a text file}" Click="OpenTextFile_Click" />
        </StackPanel>

        <StackPanel x:Name="WebPageOptions" Margin="0,16,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE8E5;" Content="{loc:T Choose a web page file}" Padding="10,3,10,4" HorizontalAlignment="Left"
                    AutomationProperties.Name="{loc:T Choose a web page file}" Click="ChooseWebPage_Click" />
            <TextBlock x:Name="WebPageName" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{loc:T Scripts and anything from the internet are left out. Pictures and styles beside the file are kept.}" />
        </StackPanel>

        <StackPanel x:Name="OfficeOptions" Margin="0,16,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE8E5;" Content="{loc:T Choose a file}" Padding="10,3,10,4" HorizontalAlignment="Left"
                    AutomationProperties.Name="{loc:T Choose a file}" Click="ChooseOffice_Click" />
            <TextBlock x:Name="OfficeState" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <DockPanel x:Name="ClipboardOptions" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE77F;" />
            <TextBlock x:Name="ClipboardState" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <DockPanel x:Name="ReasonRow" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
            <TextBlock x:Name="Reason" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <StackPanel x:Name="SetupOptions" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Paper}" />
            <ComboBox x:Name="PaperBox" AutomationProperties.Name="{loc:T Paper}" SelectionChanged="PaperBox_SelectionChanged" />
            <Grid x:Name="CustomSize" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CustomWidthLabel" Style="{StaticResource FieldLabelText}" />
                    <TextBox x:Name="CustomWidth" TextChanged="Input_Changed" LostFocus="CustomSize_LostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="CustomHeightLabel" Style="{StaticResource FieldLabelText}" />
                    <TextBox x:Name="CustomHeight" TextChanged="Input_Changed" LostFocus="CustomSize_LostFocus" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Orientation}" Margin="0,12,0,4" />
            <ComboBox x:Name="OrientationBox" SelectedIndex="0" AutomationProperties.Name="{loc:T Orientation}">
                <ComboBoxItem Content="{loc:T Automatic}" />
                <ComboBoxItem Content="{loc:T Portrait}" />
                <ComboBoxItem Content="{loc:T Landscape}" />
            </ComboBox>
            <StackPanel x:Name="MarginRow">
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Margin}" Margin="0,12,0,4" />
                <ComboBox x:Name="MarginBox" SelectedIndex="2" AutomationProperties.Name="{loc:T Margin}">
                    <ComboBoxItem Tag="0" Content="{loc:T None}" />
                    <ComboBoxItem Tag="18" Content="{loc:T Narrow}" />
                    <ComboBoxItem Tag="36" Content="{loc:T Normal}" />
                    <ComboBoxItem Tag="72" Content="{loc:T Wide}" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="FontRow">
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Font}" Margin="0,12,0,4" />
                <ComboBox x:Name="FontBox" AutomationProperties.Name="{loc:T Font}" />
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Text size}" Margin="0,12,0,4" />
                <ComboBox x:Name="FontSizeBox" SelectedIndex="2" AutomationProperties.Name="{loc:T Text size}">
                    <ComboBoxItem Tag="9" Content="9 pt" />
                    <ComboBoxItem Tag="10" Content="10 pt" />
                    <ComboBoxItem Tag="11" Content="11 pt" />
                    <ComboBoxItem Tag="12" Content="12 pt" />
                    <ComboBoxItem Tag="14" Content="14 pt" />
                    <ComboBoxItem Tag="18" Content="18 pt" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</tools:ToolPanel>
