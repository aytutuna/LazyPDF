<Window x:Class="LazyPDF.App.Tools.Pages.SourcePasswordWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LazyPDF.App"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="{x:Static loc:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButtonStyle}" Content="{loc:T _Open}" MinWidth="88" Margin="0,0,8,0" IsDefault="True"
                        AutomationProperties.Name="{loc:T Open}" Click="Open_Click" />
                <Button Content="{loc:T _Cancel}" MinWidth="88" IsCancel="True" AutomationProperties.Name="{loc:T Cancel}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="Message" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <PasswordBox x:Name="Input" AutomationProperties.Name="{loc:T Password}" />
            <TextBlock x:Name="Wrong" Style="{StaticResource ReasonText}" Margin="0,8,0,0" Visibility="Collapsed" Text="{loc:T That password is not right.}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </DockPanel>
</Window>
