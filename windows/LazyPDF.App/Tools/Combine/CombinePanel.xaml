<tools:ToolPanel x:Class="LazyPDF.App.Tools.Combine.CombinePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:combine="clr-namespace:LazyPDF.App.Tools.Combine"
                 AllowDrop="True" PreviewDragOver="Panel_DragOver" PreviewDrop="Panel_Drop">
    <StackPanel Margin="{StaticResource PanePadding}">
        <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeCombine" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Combine}" GroupName="CombineMode"
                             IsChecked="True" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Combine files}" Checked="Mode_Checked" />
                <RadioButton x:Name="ModeSplit" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Split}" GroupName="CombineMode"
                             Padding="14,5,14,6" AutomationProperties.Name="{loc:T Split this file}" Checked="Mode_Checked" />
            </StackPanel>
        </Border>

        <DockPanel x:Name="SignedRow" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;" />
            <TextBlock Style="{StaticResource ReasonText}" Text="{loc:T This file is signed. The new files do not keep its signatures.}" />
        </DockPanel>

        <StackPanel x:Name="CombineView">
            <TextBlock Text="{loc:T Files in order}" Style="{StaticResource FieldLabelText}" />
            <ItemsControl x:Name="Files" Margin="0,0,0,8" AutomationProperties.Name="{loc:T Files to combine}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type combine:CombineEntry}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10,8" AllowDrop="True"
                                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove"
                                DragLeave="Card_DragLeave" Drop="Card_Drop">
                            <Grid>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;" ToolTip="{loc:T Remove from the list}"
                                            AutomationProperties.Name="{loc:T Remove from the list}" Click="EntryRemove_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74B;" ToolTip="{loc:T Move down}"
                                            AutomationProperties.Name="{loc:T Move down}" Click="EntryDown_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74A;" ToolTip="{loc:T Move up}"
                                            AutomationProperties.Name="{loc:T Move up}" Click="EntryUp_Click" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,6,0,0">
                                    <TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding RangeName}" />
                                    <TextBlock x:Name="Hint" Text="{loc:T All pages}" Style="{StaticResource PlaceholderText}" Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                            <Border x:Name="Before" Height="2" VerticalAlignment="Top" Margin="-10,-8,-10,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <Border x:Name="After" Height="2" VerticalAlignment="Bottom" Margin="-10,0,-10,-8" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Range}" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropBefore}" Value="True">
                                <Setter TargetName="Before" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropAfter}" Value="True">
                                <Setter TargetName="After" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddFiles" Style="{StaticResource IconTextButtonStyle}" HorizontalContentAlignment="Left" Content="{loc:T Add files}"
                    loc:Icon.Glyph="&#xE710;" Margin="0,0,0,12" AutomationProperties.Name="{loc:T Add files}" Click="AddFiles_Click" />
        </StackPanel>

        <StackPanel x:Name="SplitView" Visibility="Collapsed">
            <TextBlock Text="{loc:T Split by}" Style="{StaticResource FieldLabelText}" />
            <ComboBox x:Name="SplitKind" Margin="0,0,0,12" SelectedIndex="0" AutomationProperties.Name="{loc:T Split by}" SelectionChanged="SplitKind_SelectionChanged">
                <ComboBoxItem Content="{loc:T Number of pages}" />
                <ComboBoxItem Content="{loc:T File size}" />
                <ComboBoxItem Content="{loc:T Bookmarks}" />
            </ComboBox>
            <StackPanel x:Name="AmountView" Margin="0,0,0,12">
                <TextBlock x:Name="AmountLabel" Style="{StaticResource FieldLabelText}" />
                <TextBox x:Name="Amount" Text="10" AutomationProperties.Name="{loc:T Amount per part}" TextChanged="Amount_TextChanged" />
            </StackPanel>
            <TextBlock x:Name="SplitHint" Style="{StaticResource ReasonText}" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="{loc:T Result}" Style="{StaticResource FieldLabelText}" />
        <ComboBox x:Name="Output" SelectedIndex="0" AutomationProperties.Name="{loc:T Result}">
            <ComboBoxItem Content="{loc:T Open in new tabs}" />
            <ComboBoxItem Content="{loc:T Save to a folder}" />
        </ComboBox>
    </StackPanel>
</tools:ToolPanel>
