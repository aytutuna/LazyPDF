<tools:ToolPanel x:Class="LazyPDF.App.Tools.Optimize.OptimizePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:optimize="clr-namespace:LazyPDF.App.Tools.Optimize">
    <StackPanel Margin="{StaticResource PanePadding}">
        <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Where the space goes}" />
        <TextBlock x:Name="Total" Style="{StaticResource ReasonText}" Margin="0,0,0,8" />
        <ItemsControl x:Name="Rows" Focusable="False" Margin="{StaticResource FieldSpacing}" AutomationProperties.Name="{loc:T Where the space goes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type optimize:AuditRow}">
                    <Grid Margin="0,0,0,6" AutomationProperties.Name="{Binding Summary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource ReadoutText}" Margin="8,0,0,0" />
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}" Height="4" Margin="0,3,0,0"
                                     Focusable="False" IsTabStop="False" AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Size and quality}" />
        <Border Style="{StaticResource SegmentedTrackStyle}" AutomationProperties.Name="{loc:T Size and quality}">
            <UniformGrid Rows="1">
                <RadioButton x:Name="PresetSmall" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Small}" Checked="Preset_Checked" AutomationProperties.Name="{loc:T Small}" />
                <RadioButton x:Name="PresetBalanced" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Balanced}" IsChecked="True" Checked="Preset_Checked" AutomationProperties.Name="{loc:T Balanced}" />
                <RadioButton x:Name="PresetHigh" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T High}" Checked="Preset_Checked" AutomationProperties.Name="{loc:T High}" />
                <RadioButton x:Name="PresetCustom" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Custom}" Checked="Preset_Checked" AutomationProperties.Name="{loc:T Custom}" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="PresetNote" Style="{StaticResource ReasonText}" Margin="0,6,0,12" />

        <StackPanel x:Name="CustomOptions" Visibility="Collapsed" Margin="0,12,0,12">
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Picture resolution}" />
            <ComboBox x:Name="Dpi" Margin="{StaticResource FieldSpacing}" AutomationProperties.Name="{loc:T Picture resolution}" AutomationProperties.HelpText="{loc:T Lower numbers lose detail.}" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Lower numbers lose detail.}" />
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Picture quality}" />
            <Grid Margin="{StaticResource FieldSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="Quality" Minimum="30" Maximum="95" Value="75" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                        ValueChanged="Quality_ValueChanged" AutomationProperties.Name="{loc:T Picture quality}" AutomationProperties.HelpText="{loc:T Lower numbers lose detail.}" />
                <TextBlock x:Name="QualityValue" Grid.Column="1" Style="{StaticResource ReadoutText}" />
            </Grid>
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Lower numbers lose detail.}" />
            <CheckBox x:Name="TrimFonts" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Trim fonts}" IsChecked="True" AutomationProperties.Name="{loc:T Trim fonts}" AutomationProperties.HelpText="{loc:T Nothing you can see is lost. Text cannot be edited in other programs with the missing letters.}" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Nothing you can see is lost. Text cannot be edited in other programs with the missing letters.}" />
            <CheckBox x:Name="BlackWhite" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Make black and white pictures 1-bit}" IsChecked="True" AutomationProperties.Name="{loc:T Make black and white pictures 1-bit}" AutomationProperties.HelpText="{loc:T Grey shades in those pictures are lost.}" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Grey shades in those pictures are lost.}" />
            <CheckBox x:Name="DropAppData" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Remove editing data of the program that made the file}" IsChecked="True" AutomationProperties.Name="{loc:T Remove editing data of the program that made the file}" ToolTip="{loc:T Data the program that made the file keeps for its own editing. Reading the file does not need it. Keep this off if you open the file in that program.}" AutomationProperties.HelpText="{loc:T Nothing you can see is lost.}" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Nothing you can see is lost.}" />
            <CheckBox x:Name="DropPrivateKeys" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Remove other hidden program data}" AutomationProperties.Name="{loc:T Remove other hidden program data}" ToolTip="{loc:T Extra private entries other programs added. Reading the file does not need them.}" AutomationProperties.HelpText="{loc:T Nothing you can see is lost.}" />
            <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Nothing you can see is lost.}" />
        </StackPanel>

        <CheckBox x:Name="Gray" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Convert to grayscale}" AutomationProperties.Name="{loc:T Convert to grayscale}" AutomationProperties.HelpText="{loc:T Colour is lost.}" />
        <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,8" Text="{loc:T Colour is lost.}" />
        <CheckBox x:Name="FastWeb" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Fast web view}" AutomationProperties.Name="{loc:T Fast web view}" />
        <TextBlock Style="{StaticResource ReasonText}" Margin="0,2,0,16" Text="{loc:T Page one shows before the whole file has loaded.}" />

        <optimize:OutputChoice x:Name="Output" />
    </StackPanel>
</tools:ToolPanel>
