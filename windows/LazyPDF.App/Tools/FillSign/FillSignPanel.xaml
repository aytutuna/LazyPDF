<tools:ToolPanel x:Class="LazyPDF.App.Tools.FillSign.FillSignPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:fill="clr-namespace:LazyPDF.App.Tools.FillSign">
    <StackPanel Margin="{StaticResource PanePadding}">
        <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="SignatureKind" Grid.Column="0" GroupName="FillKind" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Signature}" IsChecked="True"
                             AutomationProperties.Name="{loc:T Signature}" Checked="Kind_Checked" />
                <RadioButton x:Name="InitialsKind" Grid.Column="1" GroupName="FillKind" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Initials}"
                             AutomationProperties.Name="{loc:T Initials}" Checked="Kind_Checked" />
                <RadioButton x:Name="TextKind" Grid.Column="2" GroupName="FillKind" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Text}"
                             AutomationProperties.Name="{loc:T Text}" Checked="Kind_Checked" />
                <RadioButton x:Name="DateKind" Grid.Column="3" GroupName="FillKind" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Date}"
                             AutomationProperties.Name="{loc:T Date}" Checked="Kind_Checked" />
            </Grid>
        </Border>

        <CheckBox x:Name="KeepPlacing" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Keep placing}" Margin="0,0,0,12"
                  AutomationProperties.Name="{loc:T Keep placing}" ToolTip="{loc:T 'Stay in placing mode after each one, until Stop placing or Escape.'}" />

        <StackPanel x:Name="ImagePage">
            <StackPanel x:Name="ChoosePage">
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Saved}" />
                <ListBox x:Name="SavedList" MaxHeight="168" Margin="0,0,0,4" AutomationProperties.Name="{loc:T Saved}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         SelectionChanged="SavedList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type fill:SavedRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74D;" ToolTip="{loc:T Remove}"
                                        AutomationProperties.Name="{loc:T Remove}" Click="Remove_Click" />
                                <Border Background="White" CornerRadius="4" Height="40" Margin="0,2,8,2" Padding="4">
                                    <Image Source="{Binding Picture}" Stretch="Uniform" HorizontalAlignment="Left" />
                                </Border>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoneSaved" Style="{StaticResource ReasonText}" Margin="0,0,0,4" Text="{loc:T Nothing is saved yet.}" />
                <Button x:Name="NewButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE710;" Content="{loc:T Make a new one}" AutomationProperties.Name="{loc:T Make a new one}" Padding="10,3,10,4"
                        HorizontalAlignment="Left" Margin="0,4,0,12" Click="New_Click" />
            </StackPanel>
            <fill:SignatureMaker x:Name="Maker" Visibility="Collapsed" Margin="0,0,0,12" Made="Maker_Made" Cancelled="Maker_Cancelled" />
        </StackPanel>

        <StackPanel x:Name="TextPage" Visibility="Collapsed">
            <StackPanel x:Name="WordsPage">
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Text}" />
                <TextBox x:Name="WordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,12" AutomationProperties.Name="{loc:T Text}"
                         TextChanged="WordsBox_TextChanged" />
            </StackPanel>
            <StackPanel x:Name="FormatPage">
                <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Format}" />
                <ComboBox x:Name="FormatBox" DisplayMemberPath="Sample" Margin="0,0,0,12" AutomationProperties.Name="{loc:T Date format}" />
            </StackPanel>
            <TextBlock Style="{StaticResource FieldLabelText}" Text="{loc:T Size}" />
            <ComboBox x:Name="SizeBox" Margin="0,0,0,12" AutomationProperties.Name="{loc:T Size}" />
        </StackPanel>

        <DockPanel x:Name="Hint" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
            <TextBlock x:Name="HintText" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </StackPanel>
</tools:ToolPanel>
