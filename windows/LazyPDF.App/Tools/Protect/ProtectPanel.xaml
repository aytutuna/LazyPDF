<tools:ToolPanel x:Class="LazyPDF.App.Tools.Protect.ProtectPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:protect="clr-namespace:LazyPDF.App.Tools.Protect">
    <StackPanel Margin="12,4,12,12">
        <DockPanel x:Name="StateRow" Margin="0,0,0,12">
            <TextBlock x:Name="StateGlyph" DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
            <TextBlock x:Name="StateNote" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <StackPanel x:Name="UnlockSection" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Text="{loc:T Current permissions password}" Style="{StaticResource FieldLabelText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="UnlockBox" AutomationProperties.Name="{loc:T Current permissions password}" PasswordChanged="Password_Changed" />
                <TextBox x:Name="UnlockPlain" Grid.Column="0" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="{loc:T Hold to show the password}" />
                <Button x:Name="UnlockReveal" Grid.Column="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE7B3;" Margin="4,0,0,0"
                        ToolTip="{loc:T Hold to show the password}" AutomationProperties.Name="{loc:T Hold to show the password}"
                        PreviewMouseLeftButtonDown="Reveal_MouseDown" PreviewMouseLeftButtonUp="Reveal_MouseUp" LostMouseCapture="Reveal_Release"
                        PreviewKeyDown="Reveal_KeyDown" PreviewKeyUp="Reveal_KeyUp" LostKeyboardFocus="Reveal_Release" />
            </Grid>
        </StackPanel>

        <Border x:Name="ModeTrack" Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,16">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ModePassword" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Password}" GroupName="ProtectMode"
                             AutomationProperties.Name="{loc:T Protect with a password}" Checked="Mode_Checked" />
                <RadioButton x:Name="ModeCertificates" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Certificates}" GroupName="ProtectMode"
                             AutomationProperties.Name="{loc:T Protect for certificates}" Checked="Mode_Checked" />
                <RadioButton x:Name="ModeRemove" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Remove}" GroupName="ProtectMode"
                             AutomationProperties.Name="{loc:T Remove protection}" Checked="Mode_Checked" />
            </UniformGrid>
        </Border>

        <TextBlock x:Name="RemoveNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="{loc:T The copy opens without a password. The file in view stays as it is.}" />

        <StackPanel x:Name="PasswordSection">
            <TextBlock Text="{loc:T Password to open}" Style="{StaticResource FieldLabelText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="OpenBox" AutomationProperties.Name="{loc:T Password to open}" PasswordChanged="Password_Changed" />
                <TextBox x:Name="OpenPlain" Grid.Column="0" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="{loc:T Hold to show the password}" />
                <Button x:Name="OpenReveal" Grid.Column="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE7B3;" Margin="4,0,0,0"
                        ToolTip="{loc:T Hold to show the password}" AutomationProperties.Name="{loc:T Hold to show the password}"
                        PreviewMouseLeftButtonDown="Reveal_MouseDown" PreviewMouseLeftButtonUp="Reveal_MouseUp" LostMouseCapture="Reveal_Release"
                        PreviewKeyDown="Reveal_KeyDown" PreviewKeyUp="Reveal_KeyUp" LostKeyboardFocus="Reveal_Release" />
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="StrengthBar" Maximum="4" Height="4" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Password strength}" />
                <TextBlock x:Name="StrengthHint" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <TextBlock Text="{loc:T Repeat password}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="RepeatBox" AutomationProperties.Name="{loc:T Repeat password}" PasswordChanged="Password_Changed" />
                <TextBox x:Name="RepeatPlain" Grid.Column="0" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="{loc:T Hold to show the password}" />
                <Button x:Name="RepeatReveal" Grid.Column="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE7B3;" Margin="4,0,0,0"
                        ToolTip="{loc:T Hold to show the password}" AutomationProperties.Name="{loc:T Hold to show the password}"
                        PreviewMouseLeftButtonDown="Reveal_MouseDown" PreviewMouseLeftButtonUp="Reveal_MouseUp" LostMouseCapture="Reveal_Release"
                        PreviewKeyDown="Reveal_KeyDown" PreviewKeyUp="Reveal_KeyUp" LostKeyboardFocus="Reveal_Release" />
            </Grid>
            <TextBlock x:Name="PasswordNote" Style="{StaticResource ReasonText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel x:Name="RecipientSection">
            <TextBlock Text="{loc:T People who can open it}" Style="{StaticResource FieldLabelText}" />
            <ListBox x:Name="RecipientList" MaxHeight="150" AutomationProperties.Name="{loc:T People who can open it}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RecipientList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type protect:Recipient}">
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryBodyText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="RecipientNote" Style="{StaticResource ReasonText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="AddStoreButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE8D7;" Content="{loc:T From Windows}" AutomationProperties.Name="{loc:T From Windows}"
                        Padding="10,3,10,4" Margin="0,0,8,4" Click="AddStore_Click" />
                <Button x:Name="AddFileButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE8E5;" Content="{loc:T From a file}" AutomationProperties.Name="{loc:T From a file}"
                        Padding="10,3,10,4" Margin="0,0,8,4" Click="AddFile_Click" />
                <Button x:Name="RemoveRecipientButton" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE74D;" Content="{loc:T Remove}" AutomationProperties.Name="{loc:T Remove}"
                        Padding="10,3,10,4" Margin="0,0,0,4" IsEnabled="False" Click="RemoveRecipient_Click" />
            </WrapPanel>
        </StackPanel>

        <StackPanel x:Name="LimitSection" Margin="0,16,0,0">
            <CheckBox x:Name="LimitToggle" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Limit what people can do}"
                      AutomationProperties.Name="{loc:T Limit what people can do}" Click="Limit_Click" />
            <StackPanel x:Name="LimitDetails" Visibility="Collapsed">
                <StackPanel x:Name="OwnerRow" Margin="0,8,0,0">
                    <TextBlock Text="{loc:T Permissions password}" Style="{StaticResource FieldLabelText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="OwnerBox" AutomationProperties.Name="{loc:T Permissions password}" PasswordChanged="Password_Changed" />
                        <TextBox x:Name="OwnerPlain" Grid.Column="0" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="{loc:T Hold to show the password}" />
                        <Button x:Name="OwnerReveal" Grid.Column="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE7B3;" Margin="4,0,0,0"
                                ToolTip="{loc:T Hold to show the password}" AutomationProperties.Name="{loc:T Hold to show the password}"
                                PreviewMouseLeftButtonDown="Reveal_MouseDown" PreviewMouseLeftButtonUp="Reveal_MouseUp" LostMouseCapture="Reveal_Release"
                                PreviewKeyDown="Reveal_KeyDown" PreviewKeyUp="Reveal_KeyUp" LostKeyboardFocus="Reveal_Release" />
                    </Grid>
                    <TextBlock x:Name="OwnerNote" Style="{StaticResource ReasonText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="{loc:T People may}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                <CheckBox x:Name="CanPrint" Content="{loc:T Print}" IsChecked="True" AutomationProperties.Name="{loc:T Print}" Click="Choice_Click" />
                <CheckBox x:Name="CanPrintSharp" Content="{loc:T Print in high quality}" IsChecked="True" Margin="24,0,0,0"
                          AutomationProperties.Name="{loc:T Print in high quality}" Click="Choice_Click" />
                <CheckBox x:Name="CanCopy" Content="{loc:T Copy text and pictures}" IsChecked="True" AutomationProperties.Name="{loc:T Copy text and pictures}" />
                <CheckBox x:Name="CanEdit" Content="{loc:T Change the file}" IsChecked="True" AutomationProperties.Name="{loc:T Change the file}" />
                <CheckBox x:Name="CanAssemble" Content="{loc:T 'Insert, delete and rotate pages'}" IsChecked="True"
                          AutomationProperties.Name="{loc:T 'Insert, delete and rotate pages'}" />
                <CheckBox x:Name="CanComment" Content="{loc:T Add comments}" IsChecked="True" AutomationProperties.Name="{loc:T Add comments}" Click="Choice_Click" />
                <CheckBox x:Name="CanFill" Content="{loc:T Fill in forms}" IsChecked="True" AutomationProperties.Name="{loc:T Fill in forms}" />
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;" />
                    <TextBlock x:Name="LimitNote" Style="{StaticResource ReasonText}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="StrengthSection" Margin="0,16,0,0">
            <TextBlock Text="{loc:T Encryption}" Style="{StaticResource FieldLabelText}" />
            <ComboBox x:Name="StrengthBox" SelectedIndex="0" AutomationProperties.Name="{loc:T Encryption}" SelectionChanged="Strength_Changed">
                <ComboBoxItem Content="{loc:T AES 256-bit}" />
                <ComboBoxItem Content="{loc:T 'AES 128-bit, for older readers'}" />
            </ComboBox>
            <TextBlock x:Name="StrengthNote" Style="{StaticResource ReasonText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <DockPanel x:Name="WarnRow" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;" />
            <TextBlock x:Name="WarnNote" Style="{StaticResource ReasonText}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </StackPanel>
</tools:ToolPanel>
