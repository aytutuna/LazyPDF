<Window x:Class="LazyPDF.App.Tools.Compare.CompareWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LazyPDF.App"
        xmlns:compare="clr-namespace:LazyPDF.App.Tools.Compare"
        Width="1200" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="{x:Static loc:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="12,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SegmentedTrackStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SideButton" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Side by side}" IsChecked="True"
                                     GroupName="View" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Side by side}" Click="Layout_Click" />
                        <RadioButton x:Name="OverlayButton" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Overlay}"
                                     GroupName="View" Padding="14,5,14,6" AutomationProperties.Name="{loc:T Overlay}" Click="Layout_Click" />
                    </StackPanel>
                </Border>
                <CheckBox x:Name="LinkToggle" Style="{StaticResource ToggleSwitchStyle}" Content="{loc:T Scroll together}" IsChecked="True" Margin="20,0,0,0"
                          AutomationProperties.Name="{loc:T Scroll together}" Click="Link_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition x:Name="OldColumn" Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock x:Name="LegendText" DockPanel.Dock="Bottom" Style="{StaticResource ReasonText}" Margin="12,8,12,10" />
                <compare:ChangeList x:Name="Changes" />
            </DockPanel>
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />

            <DockPanel x:Name="OldPane" Grid.Column="1">
                <TextBlock x:Name="OldTitle" DockPanel.Dock="Top" Style="{StaticResource BodyStrongText}" Margin="12,6" TextTrimming="CharacterEllipsis" />
                <ContentControl x:Name="OldHost" IsTabStop="False" />
            </DockPanel>
            <DockPanel x:Name="NewPane" Grid.Column="2">
                <TextBlock x:Name="NewTitle" DockPanel.Dock="Top" Style="{StaticResource BodyStrongText}" Margin="12,6" TextTrimming="CharacterEllipsis" />
                <ContentControl x:Name="NewHost" IsTabStop="False" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
