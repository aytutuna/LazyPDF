<tools:ToolPanel x:Class="LazyPDF.App.Tools.Accessibility.AccessibilityPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:local="clr-namespace:LazyPDF.App.Tools.Accessibility">
    <StackPanel Margin="12,4,12,12">
        <DockPanel x:Name="SignedRow" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;" />
            <TextBlock Style="{StaticResource ReasonText}" Text="{loc:T This file is signed. Changes here break the signatures.}" />
        </DockPanel>

        <Border Style="{StaticResource SegmentedTrackStyle}">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ShowCheck" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Check}" GroupName="AccessibilityView"
                             IsChecked="True" AutomationProperties.Name="{loc:T Check}" Checked="View_Checked" />
                <RadioButton x:Name="ShowTags" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Tags}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Tags}" Checked="View_Checked" />
                <RadioButton x:Name="ShowFigures" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Figures}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Figures}" Checked="View_Checked" />
                <RadioButton x:Name="ShowRead" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Read}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Read}" Checked="View_Checked" />
            </UniformGrid>
        </Border>

        <StackPanel x:Name="CheckView" Margin="0,12,0,0">
            <TextBlock x:Name="CheckSummary" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="CheckList" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CheckRow}">
                        <Grid Margin="0,12,0,0" AutomationProperties.Name="{Binding Summary}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Mark" Style="{StaticResource GlyphText}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryBodyText}" FontSize="12" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                         AutomationProperties.Name="{Binding EditorName}"
                                         Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{Binding SaveText}" AutomationProperties.Name="{Binding SaveText}" Margin="0,0,8,0" Click="RowSave_Click"
                                            Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}" Margin="0,0,8,0" Click="RowAction_Click"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding PlaceText}" AutomationProperties.Name="{Binding PlaceText}" Click="RowPlace_Click"
                                            Visibility="{Binding HasPlaces, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Passed">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Failed">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="NeedsPerson">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="TagsView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TagsNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TreeView x:Name="TagTree" MaxHeight="320" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Tag tree}"
                      SelectedItemChanged="TagTree_SelectedItemChanged" />
        </StackPanel>

        <StackPanel x:Name="FiguresView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="FiguresNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ListBox x:Name="FigureList" MaxHeight="120" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Figures}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     SelectionChanged="FigureList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FigureRow}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryBodyText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="FigureEditor" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ImageWellStyle}" Height="120" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="FigurePicture" Stretch="Uniform" Margin="4" AutomationProperties.Name="{loc:T Picture of the figure}" />
                        <TextBlock x:Name="FigureNoPicture" Style="{StaticResource ReasonText}" Text="{loc:T No picture}" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{loc:T Description}" Style="{StaticResource FieldLabelText}" />
                    <TextBox x:Name="AltBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{loc:T Description}" TextChanged="AltBox_TextChanged" />
                </StackPanel>
            </Grid>
            <WrapPanel x:Name="FigureButtons" Margin="0,8,0,0" Visibility="Collapsed">
                <Button x:Name="SaveAlt" Content="{loc:T Save description}" AutomationProperties.Name="{loc:T Save description}" Margin="0,0,8,0" Click="SaveAlt_Click" />
                <Button x:Name="NextBare" Content="{loc:T Next without one}" AutomationProperties.Name="{loc:T Next without one}" Click="NextBare_Click" />
            </WrapPanel>
        </StackPanel>

        <StackPanel x:Name="ReadView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ReadNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="ReadAloud" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE767;" Content="{loc:T Read aloud}" Margin="0,8,0,0"
                    HorizontalAlignment="Left" AutomationProperties.Name="{loc:T Read aloud}" Click="ReadAloud_Click" />
            <ListBox x:Name="OrderList" MaxHeight="320" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Reading order}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </StackPanel>
</tools:ToolPanel>
