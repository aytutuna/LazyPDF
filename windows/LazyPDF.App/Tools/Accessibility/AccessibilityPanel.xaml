<tools:ToolPanel x:Class="LazyPDF.App.Tools.Accessibility.AccessibilityPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:loc="clr-namespace:LazyPDF.App"
                 xmlns:tools="clr-namespace:LazyPDF.App.Tools"
                 xmlns:local="clr-namespace:LazyPDF.App.Tools.Accessibility">
    <StackPanel Margin="12,4,12,12">
        <DockPanel x:Name="SignedRow" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;" />
            <TextBlock Style="{StaticResource ReasonText}" Text="{loc:T This file is signed. Changes here break the signatures.}" />
        </DockPanel>

        <Border Style="{StaticResource SegmentedTrackStyle}">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ShowCheck" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Check}" GroupName="AccessibilityView"
                             IsChecked="True" AutomationProperties.Name="{loc:T Check}" Checked="View_Checked" />
                <RadioButton x:Name="ShowTags" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Tags}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Tags}" Checked="View_Checked" />
                <RadioButton x:Name="ShowFigures" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Figures}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Figures}" Checked="View_Checked" />
                <RadioButton x:Name="ShowRead" Style="{StaticResource SegmentedTextItemStyle}" Content="{loc:T Read}" GroupName="AccessibilityView"
                             AutomationProperties.Name="{loc:T Read}" Checked="View_Checked" />
            </UniformGrid>
        </Border>

        <StackPanel x:Name="CheckView" Margin="0,12,0,0">
            <TextBlock x:Name="CheckSummary" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="CheckList" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CheckRow}">
                        <Grid Margin="0,12,0,0" AutomationProperties.Name="{Binding Summary}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Mark" Style="{StaticResource GlyphText}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryBodyText}" FontSize="12" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                         AutomationProperties.Name="{Binding EditorName}"
                                         Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock x:Name="LanguageHint" Style="{StaticResource ReasonText}" Text="{loc:T A code such as en-US or tr-TR.}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{Binding SaveText}" AutomationProperties.Name="{Binding SaveText}" Margin="0,0,8,0" Click="RowSave_Click"
                                            Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}" Margin="0,0,8,0" Click="RowAction_Click"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding PlaceText}" AutomationProperties.Name="{Binding PlaceText}" Click="RowPlace_Click"
                                            Visibility="{Binding HasPlaces, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Editor}" Value="Language">
                                <Setter TargetName="LanguageHint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Passed">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Failed">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="NeedsPerson">
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="TagsView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TagsNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <DockPanel x:Name="TagsReadOnlyRow" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE72E;" />
                <TextBlock x:Name="TagsReadOnly" Style="{StaticResource ReasonText}" TextWrapping="Wrap" />
            </DockPanel>
            <StackPanel x:Name="TagsTools" Visibility="Collapsed">
                <TextBlock Text="{loc:T Filter}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                <TextBox x:Name="TagFilterBox" AutomationProperties.Name="{loc:T Filter}" TextChanged="TagFilter_TextChanged" />
                <WrapPanel x:Name="TagButtons" Margin="0,8,0,0">
                    <Button x:Name="TagUp" Tag="MoveUp" Content="{loc:T Move up}" AutomationProperties.Name="{loc:T Move up}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagDown" Tag="MoveDown" Content="{loc:T Move down}" AutomationProperties.Name="{loc:T Move down}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagIndent" Tag="Indent" Content="{loc:T Indent}" AutomationProperties.Name="{loc:T Indent}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagOutdent" Tag="Outdent" Content="{loc:T Outdent}" AutomationProperties.Name="{loc:T Outdent}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagDelete" Tag="Delete" Content="{loc:T Delete}" AutomationProperties.Name="{loc:T Delete}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagDeleteArtifact" Tag="DeleteAsArtifact" Content="{loc:T Delete as artifact}" AutomationProperties.Name="{loc:T Delete as artifact}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagArtifact" Tag="MarkAsArtifact" Content="{loc:T Mark as artifact}" AutomationProperties.Name="{loc:T Mark as artifact}" Margin="0,0,8,4" Click="TagCommand_Click" />
                    <Button x:Name="TagHeaderRow" Tag="MakeHeaderRow" Content="{loc:T Make header row}" AutomationProperties.Name="{loc:T Make header row}" Margin="0,0,8,4" Click="TagCommand_Click" />
                </WrapPanel>
                <TextBlock x:Name="TagMessage" Style="{StaticResource ReasonText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
            </StackPanel>
            <TreeView x:Name="TagTree" MaxHeight="320" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Tag tree}" AllowDrop="True"
                      SelectedItemChanged="TagTree_SelectedItemChanged" PreviewKeyDown="TagTree_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="TagTree_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="TagTree_PreviewMouseRightButtonDown"
                      PreviewMouseMove="TagTree_PreviewMouseMove" DragOver="TagTree_DragOver" Drop="TagTree_Drop">
                <TreeView.ContextMenu>
                    <ContextMenu x:Name="TagMenu" Opened="TagMenu_Opened">
                        <MenuItem Tag="MoveUp" Header="{loc:T Move up}" InputGestureText="Alt+Up" Click="TagCommand_Click" />
                        <MenuItem Tag="MoveDown" Header="{loc:T Move down}" InputGestureText="Alt+Down" Click="TagCommand_Click" />
                        <MenuItem Tag="Indent" Header="{loc:T Indent}" InputGestureText="Alt+Right" Click="TagCommand_Click" />
                        <MenuItem Tag="Outdent" Header="{loc:T Outdent}" InputGestureText="Alt+Left" Click="TagCommand_Click" />
                        <Separator />
                        <MenuItem Tag="Delete" Header="{loc:T Delete}" InputGestureText="Del" Click="TagCommand_Click" />
                        <MenuItem Tag="DeleteAsArtifact" Header="{loc:T Delete as artifact}" InputGestureText="Ctrl+Del" Click="TagCommand_Click" />
                        <MenuItem Tag="MarkAsArtifact" Header="{loc:T Mark as artifact}" Click="TagCommand_Click" />
                        <MenuItem Tag="MakeHeaderRow" Header="{loc:T Make header row}" Click="TagCommand_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <StackPanel x:Name="TagEditor" Margin="0,12,0,0" Visibility="Collapsed" TextBoxBase.TextChanged="TagField_Changed"
                        Selector.SelectionChanged="TagField_Changed" PreviewKeyDown="TagEditor_PreviewKeyDown">
                <TextBlock Text="{loc:T Type}" Style="{StaticResource FieldLabelText}" />
                <ComboBox x:Name="TagType" IsEditable="True" AutomationProperties.Name="{loc:T Type}" />
                <TextBlock Text="{loc:T Title}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                <TextBox x:Name="TagTitle" AutomationProperties.Name="{loc:T Title}" />
                <TextBlock Text="{loc:T Alternate text}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                <TextBox x:Name="TagAlt" AutomationProperties.Name="{loc:T Alternate text}" />
                <TextBlock Text="{loc:T Replacement text}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                <TextBox x:Name="TagActual" AutomationProperties.Name="{loc:T Replacement text}" />
                <TextBlock Text="{loc:T Language}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                <TextBox x:Name="TagLang" AutomationProperties.Name="{loc:T Language}" />
                <StackPanel x:Name="TagCell" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Scope}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                    <ComboBox x:Name="TagScope" AutomationProperties.Name="{loc:T Scope}" />
                    <TextBlock Text="{loc:T Row span}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                    <TextBox x:Name="TagRowSpan" AutomationProperties.Name="{loc:T Row span}" />
                    <TextBlock Text="{loc:T Column span}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                    <TextBox x:Name="TagColSpan" AutomationProperties.Name="{loc:T Column span}" />
                    <TextBlock Text="{loc:T Header cells}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                    <TextBox x:Name="TagHeaders" AutomationProperties.Name="{loc:T Header cells}" />
                </StackPanel>
                <TextBlock x:Name="TagFieldMessage" Style="{StaticResource ReasonText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
                <Button x:Name="TagApply" Content="{loc:T Apply}" AutomationProperties.Name="{loc:T Apply}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="TagApply_Click" />
            </StackPanel>

            <StackPanel x:Name="TagSelectionTools" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="{loc:T Tag the selection as}" Style="{StaticResource FieldLabelText}" />
                <ComboBox x:Name="TagAs" IsEditable="True" AutomationProperties.Name="{loc:T Tag the selection as}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="TagSelect" Content="{loc:T Tag selection}" AutomationProperties.Name="{loc:T Tag selection}" Margin="0,0,8,4" Click="TagSelection_Click" />
                    <Button x:Name="TagDraw" Content="{loc:T Tag drawn area}" AutomationProperties.Name="{loc:T Tag drawn area}" Margin="0,0,8,4" Click="TagDraw_Click" />
                    <Button x:Name="TagSelectionArtifact" Content="{loc:T Selection as artifact}" AutomationProperties.Name="{loc:T Selection as artifact}" Margin="0,0,8,4" Click="TagSelectionArtifact_Click" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="FiguresView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="FiguresNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ListBox x:Name="FigureList" MaxHeight="120" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Figures}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     SelectionChanged="FigureList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FigureRow}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryBodyText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="FigureEditor" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ImageWellStyle}" Height="120" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="FigurePicture" Stretch="Uniform" Margin="4" AutomationProperties.Name="{loc:T Picture of the figure}" />
                        <TextBlock x:Name="FigureNoPicture" Style="{StaticResource ReasonText}" Text="{loc:T No picture}" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{loc:T Description}" Style="{StaticResource FieldLabelText}" />
                    <TextBox x:Name="AltBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{loc:T Description}" TextChanged="AltBox_TextChanged" />
                </StackPanel>
            </Grid>
            <WrapPanel x:Name="FigureButtons" Margin="0,8,0,0" Visibility="Collapsed">
                <Button x:Name="SaveAlt" Content="{loc:T Save description}" AutomationProperties.Name="{loc:T Save description}" Margin="0,0,8,0" Click="SaveAlt_Click" />
                <Button x:Name="NextBare" Content="{loc:T Next without one}" AutomationProperties.Name="{loc:T Next without one}" Click="NextBare_Click" />
            </WrapPanel>
        </StackPanel>

        <StackPanel x:Name="ReadView" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ReadNote" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="ReadAloud" Style="{StaticResource IconTextButtonStyle}" loc:Icon.Glyph="&#xE767;" Content="{loc:T Read aloud}" Margin="0,8,0,0"
                    HorizontalAlignment="Left" AutomationProperties.Name="{loc:T Read aloud}" Click="ReadAloud_Click" />
            <ListBox x:Name="OrderList" MaxHeight="320" Margin="0,8,0,0" AutomationProperties.Name="{loc:T Reading order}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </StackPanel>
</tools:ToolPanel>
